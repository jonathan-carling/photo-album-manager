<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PhotoAlbumManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PhotoAlbumManager.ViewModels"
    Title="Photo Album Manager">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Shell" Loaded="OnLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftPadding" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TitleBarRightPadding" Width="138" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="12,0,0,0">
                <FontIcon Glyph="&#xE91B;" FontSize="16" />
                <TextBlock Text="Photo Album Manager" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <MenuBar Grid.Row="1" Padding="4,0,4,0">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="New album (Ctrl+N)" Command="{x:Bind ViewModel.NewAlbumCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="SaveMenuItem" Text="Save (Ctrl+S)" Command="{x:Bind ViewModel.SaveCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Delete album" Command="{x:Bind ViewModel.DeleteAlbumCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Tags..." Command="{x:Bind ViewModel.ManageTagsCommand}" />
                <MenuFlyoutItem Text="People..." Command="{x:Bind ViewModel.ManagePeopleCommand}" />
                <MenuFlyoutItem Text="Locations..." Command="{x:Bind ViewModel.ManageLocationsCommand}" />
                <MenuFlyoutItem Text="Owners..." Command="{x:Bind ViewModel.ManageOwnersCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Add photos and videos..." Command="{x:Bind ViewModel.AddMediaCommand}" />
                <MenuFlyoutItem Text="Set selected item as cover" Command="{x:Bind ViewModel.SetCoverCommand}" />
                <MenuFlyoutItem Text="Remove selected item (Del)" Command="{x:Bind ViewModel.RemoveItemCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Folders..." Command="{x:Bind ViewModel.SettingsCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Exit" Command="{x:Bind ViewModel.ExitCommand}" />
            </MenuBarItem>
            <MenuBarItem Title="View">
                <MenuFlyoutItem Text="Refresh (F5)" Command="{x:Bind ViewModel.RefreshCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="About Photo Album Manager" Command="{x:Bind ViewModel.AboutCommand}" />
            </MenuBarItem>
        </MenuBar>

        <Border Grid.Row="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <CommandBar DefaultLabelPosition="Right" Background="Transparent" OverflowButtonVisibility="Collapsed" IsOpen="False">
                <AppBarButton AutomationProperties.AutomationId="NewAlbumButton" Label="New" Icon="Add" Command="{x:Bind ViewModel.NewAlbumCommand}" ToolTipService.ToolTip="Create a virtual album" />
                <AppBarButton AutomationProperties.AutomationId="SaveButton" Label="Save" Icon="Save" Command="{x:Bind ViewModel.SaveCommand}" ToolTipService.ToolTip="Save album metadata" />
                <AppBarButton AutomationProperties.AutomationId="DeleteAlbumButton" Label="Delete" Icon="Delete" Command="{x:Bind ViewModel.DeleteAlbumCommand}" ToolTipService.ToolTip="Delete the selected album" />
                <AppBarSeparator />
                <AppBarButton AutomationProperties.AutomationId="TagsButton" Label="Tags" Icon="Tag" Command="{x:Bind ViewModel.ManageTagsCommand}" ToolTipService.ToolTip="Add, rename, or delete tags" />
                <AppBarButton AutomationProperties.AutomationId="PeopleButton" Label="People" Icon="People" Command="{x:Bind ViewModel.ManagePeopleCommand}" ToolTipService.ToolTip="Add, rename, or delete people" />
                <AppBarButton AutomationProperties.AutomationId="LocationsButton" Label="Locations" Icon="Map" Command="{x:Bind ViewModel.ManageLocationsCommand}" ToolTipService.ToolTip="Add, rename, or delete locations" />
                <AppBarButton AutomationProperties.AutomationId="OwnersButton" Label="Owners" Icon="Contact" Command="{x:Bind ViewModel.ManageOwnersCommand}" ToolTipService.ToolTip="Add, rename, or delete owners" />
                <AppBarSeparator />
                <AppBarButton AutomationProperties.AutomationId="AddMediaButton" Label="Add media" Icon="Pictures" Command="{x:Bind ViewModel.AddMediaCommand}" ToolTipService.ToolTip="Reference photos or videos from the media root" />
                <AppBarButton AutomationProperties.AutomationId="SetCoverButton" Label="Set cover" Icon="Favorite" Command="{x:Bind ViewModel.SetCoverCommand}" ToolTipService.ToolTip="Use the selected item as the album cover" />
                <AppBarButton AutomationProperties.AutomationId="RemoveItemButton" Label="Remove" Icon="Remove" Command="{x:Bind ViewModel.RemoveItemCommand}" ToolTipService.ToolTip="Remove the selected item from the album" />
                <AppBarSeparator />
                <AppBarButton AutomationProperties.AutomationId="RefreshButton" Label="Refresh" Icon="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" ToolTipService.ToolTip="Reload albums from disk" />
            </CommandBar>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="12,12,12,8" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Albums" Style="{StaticResource PanelTitleStyle}" />

                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Year" Style="{StaticResource HintStyle}" />
                        <ComboBox AutomationProperties.AutomationId="YearFilter" ItemsSource="{x:Bind ViewModel.YearOptions}" SelectedItem="{x:Bind ViewModel.SelectedYear, Mode=TwoWay}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="Month" Style="{StaticResource HintStyle}" />
                        <ComboBox AutomationProperties.AutomationId="MonthFilter" ItemsSource="{x:Bind ViewModel.MonthOptions}" SelectedItem="{x:Bind ViewModel.SelectedMonth, Mode=TwoWay}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="Day" Style="{StaticResource HintStyle}" />
                        <ComboBox AutomationProperties.AutomationId="DayFilter" ItemsSource="{x:Bind ViewModel.DayOptions}" SelectedItem="{x:Bind ViewModel.SelectedDay, Mode=TwoWay}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>

                <TextBox
                    x:Name="AlbumSearch"
                    Grid.Row="2"
                    AutomationProperties.AutomationId="AlbumSearch"
                    PlaceholderText="Search titles"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <DropDownButton
                    Grid.Row="3"
                    AutomationProperties.AutomationId="TagFilter"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left">
                    <TextBlock Text="{x:Bind ViewModel.FilterTagSummary, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    <DropDownButton.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                            <StackPanel MinWidth="260" MaxWidth="320">
                                <TextBlock Text="Select any number of tags." Style="{StaticResource HintStyle}" Margin="0,0,0,8" />
                                <ScrollViewer MaxHeight="240">
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.FilterTagChoices, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SelectableEntity">
                                                <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Margin="0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <Grid Grid.Row="4">
                    <ListView
                        x:Name="AlbumList"
                        AutomationProperties.AutomationId="AlbumList"
                        ItemsSource="{x:Bind ViewModel.FilteredAlbums}"
                        SelectionMode="Single"
                        SelectionChanged="AlbumList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:AlbumRowViewModel">
                                <StackPanel Padding="2,8" AutomationProperties.Name="{x:Bind DisplayName}">
                                    <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource HintStyle}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        Text="No albums match these filters."
                        Style="{StaticResource HintStyle}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.NoAlbumsVisibility, Mode=OneWay}" />
                </Grid>
            </Grid>

            <Rectangle Grid.Column="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <Grid x:Name="ItemPanel" Grid.Column="2" Padding="16,12,16,12" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.AlbumHeading, Mode=OneWay}" Style="{StaticResource PanelTitleStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource HintStyle}">
                        <Run Text="{x:Bind ViewModel.ItemCountLabel, Mode=OneWay}" />
                        <Run Text="   Drag thumbnails to reorder. Save writes the album database only." />
                    </TextBlock>
                </StackPanel>

                <Grid Grid.Row="1">
                    <GridView
                        x:Name="ItemGrid"
                        AutomationProperties.AutomationId="ItemGrid"
                        ItemsSource="{x:Bind ViewModel.Items}"
                        SelectionMode="Single"
                        CanDragItems="{x:Bind ViewModel.AllowItemReorder, Mode=OneWay}"
                        CanReorderItems="{x:Bind ViewModel.AllowItemReorder, Mode=OneWay}"
                        AllowDrop="{x:Bind ViewModel.AllowItemReorder, Mode=OneWay}"
                        IsSwipeEnabled="False"
                        SelectionChanged="ItemGrid_SelectionChanged"
                        DragItemsCompleted="ItemGrid_DragItemsCompleted"
                        KeyDown="ItemGrid_KeyDown"
                        ContainerContentChanging="ItemGrid_ContainerContentChanging"
                        Visibility="{x:Bind ViewModel.AlbumEditorVisibility, Mode=OneWay}">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="vm:MediaItemViewModel">
                                <Grid Width="188" AutomationProperties.Name="{x:Bind Title, Mode=OneWay}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="140" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8">
                                        <Grid>
                                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                                            <Border
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Margin="8"
                                                Padding="6,2"
                                                CornerRadius="4"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                                                <TextBlock Text="{x:Bind OrderLabel, Mode=OneWay}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontSize="12" />
                                            </Border>
                                            <Border
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="8"
                                                Padding="6,2"
                                                CornerRadius="4"
                                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                                Visibility="{x:Bind VideoVisibility, Mode=OneWay}">
                                                <TextBlock Text="Video" FontSize="12" />
                                            </Border>
                                            <Border
                                                AutomationProperties.Name="Cover"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Bottom"
                                                Margin="8"
                                                Width="28"
                                                Height="28"
                                                CornerRadius="14"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                Visibility="{x:Bind CoverVisibility, Mode=OneWay}">
                                                <FontIcon Glyph="&#xE735;" FontSize="14" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <FontIcon
                                                Glyph="&#xE7BA;"
                                                FontSize="28"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Opacity="0.8"
                                                Visibility="{x:Bind MissingVisibility, Mode=OneWay}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="2,8,2,0"
                                        Text="{x:Bind Title, Mode=OneWay}"
                                        MaxLines="2"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6"
                        MaxWidth="420"
                        Visibility="{x:Bind ViewModel.EmptyAlbumVisibility, Mode=OneWay}">
                        <TextBlock Text="Select an album" Style="{StaticResource PanelTitleStyle}" HorizontalAlignment="Center" />
                        <TextBlock
                            Text="Virtual albums are stored in a SQLite database. The photos and videos stay where they are in the media root."
                            Style="{StaticResource HintStyle}"
                            TextAlignment="Center" />
                    </StackPanel>

                    <ProgressRing
                        AutomationProperties.AutomationId="LoadingSpinner"
                        Width="56"
                        Height="56"
                        IsActive="{x:Bind ViewModel.IsLoadingItems, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False" />

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6"
                        MaxWidth="460"
                        Visibility="{x:Bind ViewModel.EmptyItemsVisibility, Mode=OneWay}">
                        <TextBlock Text="This album is empty" Style="{StaticResource PanelTitleStyle}" HorizontalAlignment="Center" />
                        <TextBlock
                            Text="Add photos or videos from the media root. The album stores a relative path and does not copy the file."
                            Style="{StaticResource HintStyle}"
                            TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Rectangle Grid.Column="3" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <Grid Grid.Column="4" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TabView
                    x:Name="MetaTabs"
                    Grid.Row="0"
                    IsAddTabButtonVisible="False"
                    CanDragTabs="False"
                    CanReorderTabs="False"
                    TabWidthMode="SizeToContent">
                    <TabView.TabItems>
                        <TabViewItem x:Name="AlbumMetaTab" Header="Album Meta" IsClosable="False">
                            <ScrollViewer Padding="16,12,16,16" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="0">
                        <TextBlock
                            Text="Select an album to edit its metadata."
                            Style="{StaticResource HintStyle}"
                            Visibility="{x:Bind ViewModel.EmptyAlbumVisibility, Mode=OneWay}" />

                        <StackPanel Visibility="{x:Bind ViewModel.AlbumEditorVisibility, Mode=OneWay}">
                            <TextBlock Text="Title" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox AutomationProperties.AutomationId="AlbumTitleBox" Text="{x:Bind ViewModel.AlbumTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Description" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{x:Bind ViewModel.AlbumDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="72" />

                            <TextBlock Text="Date from" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox PlaceholderText="yyyy-MM-dd HH:mm:ss" Text="{x:Bind ViewModel.AlbumDateFromText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Date to" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox PlaceholderText="yyyy-MM-dd HH:mm:ss" Text="{x:Bind ViewModel.AlbumDateToText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Location" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox AutomationProperties.AutomationId="AlbumLocationBox" ItemsSource="{x:Bind ViewModel.LocationChoices, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedAlbumLocation, Mode=TwoWay}" DisplayMemberPath="Name" HorizontalAlignment="Stretch" />

                            <TextBlock Text="Owner" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox AutomationProperties.AutomationId="AlbumOwnerBox" ItemsSource="{x:Bind ViewModel.OwnerChoices, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedAlbumOwner, Mode=TwoWay}" DisplayMemberPath="Name" HorizontalAlignment="Stretch" />

                            <TextBlock Text="Tags" Style="{StaticResource FieldLabelStyle}" />
                            <DropDownButton
                                AutomationProperties.AutomationId="AlbumTagsPicker"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left">
                                <TextBlock Text="{x:Bind ViewModel.AlbumTagSummary, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                <DropDownButton.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                        <StackPanel MinWidth="260" MaxWidth="360">
                                            <TextBlock Text="Select any number of tags." Style="{StaticResource HintStyle}" Margin="0,0,0,8" />
                                            <ScrollViewer MaxHeight="240">
                                                <ItemsControl ItemsSource="{x:Bind ViewModel.AlbumTagChoices, Mode=OneWay}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:SelectableEntity">
                                                            <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Margin="0,2" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Flyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>

                            <TextBlock Text="Cover" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox AutomationProperties.AutomationId="AlbumCoverBox" Text="{x:Bind ViewModel.CoverText, Mode=OneWay}" IsReadOnly="True" />
                        </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabViewItem>
                        <TabViewItem x:Name="ItemMetaTab" Header="Item Meta" IsClosable="False" Visibility="Collapsed">
                            <ScrollViewer Padding="16,12,16,16" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="0">
                            <TextBlock Text="Id" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{x:Bind ViewModel.ItemIdText, Mode=OneWay}" IsReadOnly="True" />

                            <TextBlock Text="Title" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox AutomationProperties.AutomationId="ItemTitleBox" Text="{x:Bind ViewModel.ItemTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Description" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{x:Bind ViewModel.ItemDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="72" />

                            <TextBlock Text="Date taken" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox PlaceholderText="yyyy-MM-dd HH:mm:ss" Text="{x:Bind ViewModel.ItemDateTakenText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Location" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox AutomationProperties.AutomationId="ItemLocationBox" ItemsSource="{x:Bind ViewModel.LocationChoices, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedItemLocation, Mode=TwoWay}" DisplayMemberPath="Name" HorizontalAlignment="Stretch" />

                            <TextBlock Text="Owner" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox AutomationProperties.AutomationId="ItemOwnerBox" ItemsSource="{x:Bind ViewModel.OwnerChoices, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedItemOwner, Mode=TwoWay}" DisplayMemberPath="Name" HorizontalAlignment="Stretch" />

                            <TextBlock Text="Tags" Style="{StaticResource FieldLabelStyle}" />
                            <DropDownButton
                                AutomationProperties.AutomationId="ItemTagsPicker"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left">
                                <TextBlock Text="{x:Bind ViewModel.ItemTagSummary, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                <DropDownButton.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                        <StackPanel MinWidth="260" MaxWidth="360">
                                            <TextBlock Text="Select any number of tags." Style="{StaticResource HintStyle}" Margin="0,0,0,8" />
                                            <ScrollViewer MaxHeight="240">
                                                <ItemsControl ItemsSource="{x:Bind ViewModel.ItemTagChoices, Mode=OneWay}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:SelectableEntity">
                                                            <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Margin="0,2" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Flyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>

                            <TextBlock Text="People" Style="{StaticResource FieldLabelStyle}" />
                            <DropDownButton
                                AutomationProperties.AutomationId="ItemPeoplePicker"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left">
                                <TextBlock Text="{x:Bind ViewModel.ItemPeopleSummary, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                <DropDownButton.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                        <StackPanel MinWidth="260" MaxWidth="360">
                                            <TextBlock Text="Select any number of people." Style="{StaticResource HintStyle}" Margin="0,0,0,8" />
                                            <ScrollViewer MaxHeight="240">
                                                <ItemsControl ItemsSource="{x:Bind ViewModel.ItemPeopleChoices, Mode=OneWay}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:SelectableEntity">
                                                            <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Margin="0,2" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Flyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>

                            <TextBlock Text="Relative path" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{x:Bind ViewModel.ItemFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />

                            <TextBlock Text="Resolved path" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{x:Bind ViewModel.ItemResolvedPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" />

                            <TextBlock Text="{x:Bind ViewModel.ItemMissingText, Mode=OneWay}" Margin="0,6,0,0" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabViewItem>
                    </TabView.TabItems>
                </TabView>
                <TextBlock
                    Grid.Row="1"
                    Text="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}"
                    Margin="16,0,16,12"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Visibility="{x:Bind ViewModel.ValidationVisibility, Mode=OneWay}" />
            </Grid>
        </Grid>

        <Border Grid.Row="4" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <TextBlock AutomationProperties.AutomationId="StatusText" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DirtyLabel, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="Media is read-only" Opacity="0.7" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.MediaRootText, Mode=OneWay}" Opacity="0.7" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
